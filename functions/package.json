{
    "name": "artist-community-functions",
    "private": true,
    "main": "src/index.js",
    "engines": {
        "node": "20"
    },
    "scripts": {
        "serve": "firebase emulators:start --only functions",
        "shell": "firebase functions:shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "test:rules": "firebase emulators:exec --project demo-artist-community --only firestore,storage \"node --test tests/firestore.rules.test.js\"",
        "test": "npm run test:rules"
    },
    "dependencies": {
        "firebase-admin": "^12.7.0",
        "firebase-functions": "^5.1.1",
        "stripe": "^17.7.0"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.0",
        "firebase": "^12.11.0"
    }
}